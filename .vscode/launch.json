{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/api/cmd/api",
      "cwd": "${workspaceFolder}/apps/api",
      "env": {
        "APP_ENV": "development",
        "API_ADDR": ":8080",
        "DATABASE_URL": "postgres://user:pass@localhost:5432/comune_dev?sslmode=disable",
        "SESSION_SECRET": "dev-session-secret-change-me",
        "SESSION_DURATION": "168h"
      }
    },
    {
      "name": "Run Svelte Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      "name": "Debug Svelte In Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Debug Svelte App",
      "configurations": [
        "Run Svelte Dev Server",
        "Debug Svelte In Chrome"
      ]
    }
  ]
}
